{
  "dependencies": [
    "."
  ],
  "graphs": {
    "supervisor": "core.graph_plan:supervisor_graph"
  },
  "env": ".env",
  "http": {
    "cors": {
      "allow_origins": [
        "https://smith.langchain.com",
        "https://eu.smith.langchain.com"
      ],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allow_headers": ["*"],
      "allow_credentials": true
    }
  },
  "startup_timeout": 30,
  "store": {
    "index": {
      "embed": "core/store_embeddings.py:aembed_texts",
      "dims": 384,
      "fields": ["input", "plan", "past_steps", "response", "feeedback"]
    }
  }
}
